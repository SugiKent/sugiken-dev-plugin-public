{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ja-writing-lint",
            "timeout": 10,
            "statusMessage": "日本語チェック中..."
          }
        ]
      }
    ]
  }
}
