#!/usr/bin/env python3
"""PostToolUse hook: AI が書いた日本語ドキュメントの癖を書き込み直後に検査する。

検知するのは以下の 4 パターン（ルールは ja-writing-rules.json で育てる）。
  1. 効果の中身を書かずに「効く」の一語で済ませる
  2. 頼んでいない対比で「AではなくB」と否定から入る
  3. 主語や助詞が抜けていて、誰が何をするのか読めない
  4. 「〜ます。〜ます。〜ます。」と同じ文末が続いて単調になる

該当があれば stderr へ警告を出して exit 2 で返す。PostToolUse の exit 2 は
編集を巻き戻さずエージェント自身へ内容を渡すため、処理を止めずに書き直させられる。
内部エラーは全て握りつぶして exit 0（検査が壊れて作業を止める方が害が大きい）。
"""

import json
import os
import re
import sys

RULES_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ja-writing-rules.json")

TARGET_EXTS = (".md", ".mdx", ".txt")
# 自分自身のルール定義は NG 表現を含むので検査対象から外す
EXCLUDE_DIR_PARTS = (
    os.path.join(".claude", "hooks"),
    os.path.join(".claude-personal", "hooks"),
    os.path.join("plugins", "basic", "hooks"),
    "node_modules",
    "scratchpad",
)

JA_CHARS = re.compile(r"[぀-ヿ一-鿿]")
MAX_FINDINGS = 5

# 文末の分類。上から順に判定する（ました を ます より先に見る）。
ENDING_PATTERNS = [
    ("ました", re.compile(r"(ました|でした)$")),
    ("ません", re.compile(r"(ません|ませんでした)$")),
    ("ます", re.compile(r"ます$")),
    ("です", re.compile(r"です$")),
]


def mask_non_prose(text):
    """コードブロック・インラインコード・URL・front matter を伏せる（行数は保つ）。"""
    lines = text.split("\n")
    out = []
    in_fence = False
    for i, line in enumerate(lines):
        if re.match(r"^\s*(```|~~~)", line):
            in_fence = not in_fence
            out.append("")
            continue
        if in_fence:
            out.append("")
            continue
        if i == 0 and line.strip() == "---":  # front matter の開始
            in_fence = True
            out.append("")
            continue
        line = re.sub(r"`[^`]*`", "", line)
        line = re.sub(r"https?://\S+", "", line)
        line = re.sub(r"^\s{4,}\S.*$", "", line)  # インデントコードブロック
        out.append(line)
    return "\n".join(out)


def split_blocks(text):
    """空行と見出しでブロックに割る。文末連続の判定がブロックをまたがないようにする。"""
    blocks, current = [], []
    for line in text.split("\n"):
        if not line.strip() or re.match(r"^\s*#{1,6}\s", line) or re.match(r"^\s*(\||-{3,})", line):
            if current:
                blocks.append("\n".join(current))
                current = []
            continue
        current.append(line)
    if current:
        blocks.append("\n".join(current))
    return blocks


def split_sentences(block):
    stripped = re.sub(r"^\s*([-*+]|\d+\.)\s+", "", block, flags=re.MULTILINE)
    parts = re.split(r"(?<=[。！？!?])\s*|\n", stripped)
    return [p.strip() for p in parts if p.strip()]


def classify_ending(sentence):
    body = re.sub(r"[。！？!?」）\)]+$", "", sentence)
    for name, pattern in ENDING_PATTERNS:
        if pattern.search(body):
            return name
    return None


def excerpt(sentence, limit=60):
    return sentence if len(sentence) <= limit else sentence[:limit] + "…"


def check(text, rules):
    findings = []
    masked = mask_non_prose(text)

    for rule in rules.get("regex_rules", []):
        try:
            pattern = re.compile(rule["pattern"])
        except re.error:
            continue
        for block in split_blocks(masked):
            for sentence in split_sentences(block):
                m = pattern.search(sentence)
                if m:
                    findings.append((rule["name"], "「%s」" % m.group(0), sentence, rule["good"]))

    heur = rules.get("heuristic_rules", {})

    subj = heur.get("missing-subject")
    if subj:
        particles = subj.get("required_particles", [])
        min_chars = subj.get("min_chars", 30)
        for block in split_blocks(masked):
            for sentence in split_sentences(block):
                body = re.sub(r"[。！？!?]+$", "", sentence)
                if len(body) < min_chars:
                    continue
                if any(p in body for p in particles):
                    continue
                findings.append((subj["name"], "助詞なし", sentence, subj["good"]))

    mono = heur.get("monotonous-ending")
    if mono:
        max_run = mono.get("max_run", 2)
        for block in split_blocks(masked):
            sentences = split_sentences(block)
            run_name, run = None, []
            for sentence in sentences + [""]:
                name = classify_ending(sentence) if sentence else None
                if name is not None and name == run_name:
                    run.append(sentence)
                    continue
                if run_name is not None and len(run) > max_run:
                    findings.append((
                        mono["name"],
                        "文末「%s」が %d 文連続" % (run_name, len(run)),
                        " / ".join(excerpt(s, 25) for s in run),
                        mono["good"],
                    ))
                run_name, run = name, ([sentence] if name else [])
    return findings


def extract_text(payload):
    tool = payload.get("tool_name", "")
    ti = payload.get("tool_input") or {}
    if tool == "Write":
        return ti.get("file_path", ""), ti.get("content", "")
    if tool == "Edit":
        if ti.get("new_string") is not None:
            return ti.get("file_path", ""), ti.get("new_string", "")
    return ti.get("file_path", ""), ""


def main():
    payload = json.load(sys.stdin)
    path, text = extract_text(payload)
    if not path or not text:
        return 0
    if not path.lower().endswith(TARGET_EXTS):
        return 0
    if any(part in path for part in EXCLUDE_DIR_PARTS):
        return 0
    if not JA_CHARS.search(text):
        return 0

    with open(RULES_PATH, encoding="utf-8") as f:
        rules = json.load(f)

    findings = check(text, rules)
    if not findings:
        return 0

    total = len(findings)
    lines = [
        "【日本語チェック】%s に %d 件の指摘があります。" % (os.path.basename(path), total),
        "語だけの置き換えは禁止です。検出箇所を含む文を丸ごと書き直してください。",
        "",
    ]
    for i, (name, matched, sentence, good) in enumerate(findings[:MAX_FINDINGS], 1):
        lines.append("%d. %s（%s）" % (i, name, matched))
        lines.append("   該当: %s" % excerpt(sentence))
        lines.append("   書き直しの型: %s" % " / ".join(good))
    if total > MAX_FINDINGS:
        lines.append("…ほか %d 件（同種の癖が残っていないか全体を見直してください）" % (total - MAX_FINDINGS))
    sys.stderr.write("\n".join(lines) + "\n")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
